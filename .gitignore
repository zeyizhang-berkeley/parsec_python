!/src/parsec_python/tests/data/*.DAT
!/src/parsec_python/tests/data/*.in
!/src/parsec_python/tests/data/*.json
!/src/parsec_python/acceleration/tests/data/*.DAT
!/src/parsec_python/acceleration/tests/data/*.in
/src/parsec_python/acceleration/native/build/
/src/parsec_python/acceleration/native/dist/
/src/parsec_python/acceleration/native/*.egg-info/

# Launch scripts
!/scripts/
!/scripts/*.sh

# Publish runnable calculations beside src, while keeping generated caches and
# ordinary run outputs local.
!/examples/
!/examples/**/
!/examples/**/*.md
!/examples/**/*.py
!/examples/**/*.DAT
!/examples/**/*.in
!/examples/**/*reference.out
!/examples/**/*python.out
!/examples/**/*reference_time.txt
!/examples/ml_initial_density/**/*.npz
!/examples/ml_initial_density/**/*.csv
!/examples/ml_initial_density/**/parsec.out
!/examples/ml_initial_density/**/parsec_chebff.out
!/examples/ml_initial_density/figures/chebff_chebdav_iterations_timing.png
!/examples/ml_initial_density/figures/chebff_chebdav_iterations_timing.pdf
!/examples/0_CH4_CF4/0_ARES_CH4_CF4/test_CH4_CF4/pbe/**/ares.log
/examples/**/.parsec_cache/

# Ignore generated Python artifacts anywhere
**/__pycache__/
**/*.py[cod]

# Local-only folders
/.cuda-shim/
/.cupy-cache/
/.mplconfig/
/.tmp/
/.venv/
/.venv312/
/parsec_python-cpu/
/parsec_python-gpu/
/samples/
!/samples/
!/samples/**
/.DS_Store

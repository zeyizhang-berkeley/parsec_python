# end pseudopotential libraries
!/src/parsec_python/**/*.md
!/src/parsec_python/requirements*.txt
!/src/parsec_python/**/*.toml
!/src/parsec_python/**/CMakeLists.txt
!/src/parsec_python/**/*.cpp
!/src/parsec_python/**/*.cu
!/src/parsec_python/**/*.h

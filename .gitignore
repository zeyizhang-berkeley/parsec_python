*

# Keep the repo-level ignore file
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/pyproject.toml

# Publish the canonical Python package and support tools
!/src/
!/src/**/
!/src/*.py
!/src/*.csv
!/src/**/*.py
!/src/**/*.csv
!/src/pp_generation/**/*.md
# pseudopotential libraries
!/src/pp_generation/NCPPs/**
# core holes of H-Kr; the heavier elements are in the branch pseudopotential
!/src/pp_generation/CoreHole_NCPPs/*/Li/**
!/src/pp_generation/CoreHole_NCPPs/*/Be/**
!/src/pp_generation/CoreHole_NCPPs/*/B/**
!/src/pp_generation/CoreHole_NCPPs/*/C/**
!/src/pp_generation/CoreHole_NCPPs/*/N/**
!/src/pp_generation/CoreHole_NCPPs/*/O/**
!/src/pp_generation/CoreHole_NCPPs/*/F/**
!/src/pp_generation/CoreHole_NCPPs/*/Ne/**
!/src/pp_generation/CoreHole_NCPPs/*/Na/**
!/src/pp_generation/CoreHole_NCPPs/*/Mg/**
!/src/pp_generation/CoreHole_NCPPs/*/Al/**
!/src/pp_generation/CoreHole_NCPPs/*/Si/**
!/src/pp_generation/CoreHole_NCPPs/*/P/**
!/src/pp_generation/CoreHole_NCPPs/*/S/**
!/src/pp_generation/CoreHole_NCPPs/*/Cl/**
!/src/pp_generation/CoreHole_NCPPs/*/Ar/**
!/src/pp_generation/CoreHole_NCPPs/*/K/**
!/src/pp_generation/CoreHole_NCPPs/*/Ca/**
!/src/pp_generation/CoreHole_NCPPs/*/Sc/**
!/src/pp_generation/CoreHole_NCPPs/*/Ti/**
!/src/pp_generation/CoreHole_NCPPs/*/V/**
!/src/pp_generation/CoreHole_NCPPs/*/Cr/**
!/src/pp_generation/CoreHole_NCPPs/*/Mn/**
!/src/pp_generation/CoreHole_NCPPs/*/Fe/**
!/src/pp_generation/CoreHole_NCPPs/*/Co/**
!/src/pp_generation/CoreHole_NCPPs/*/Ni/**
!/src/pp_generation/CoreHole_NCPPs/*/Cu/**
!/src/pp_generation/CoreHole_NCPPs/*/Zn/**
!/src/pp_generation/CoreHole_NCPPs/*/Ga/**
!/src/pp_generation/CoreHole_NCPPs/*/Ge/**
!/src/pp_generation/CoreHole_NCPPs/*/As/**
!/src/pp_generation/CoreHole_NCPPs/*/Se/**
!/src/pp_generation/CoreHole_NCPPs/*/Br/**

# Auto detect text files and perform LF normalization
* text=auto
# Shell scripts keep LF in every checkout: with CRLF they do not start.
*.sh text eol=lf
# Generated pseudopotential files and Fortran reference files are compared byte for
# byte (hashes in report.json, test fixtures): no line-ending conversion.
src/pp_generation/NCPPs/*/** -text
src/pp_generation/CoreHole_NCPPs/*/** -text
src/pp_generation/tests/data/** -text
